    {
      "parameters": {
        "jsCode": "const input = $input.item.json;\nconst text = (input.message?.text || \"\").trim();\nconst chatId = input.message?.chat?.id;\nconst parts = text.split(/\\s+/);\nconst arg = (parts[1] || \"\").toLowerCase();\n\nlet action, time = null, reply_invalid = null;\nif (!arg) {\n  action = 'status';\n} else if (arg === 'off' || arg === 'apagar') {\n  action = 'off';\n} else if (/^([01]\\d|2[0-3]):([0-5]\\d)$/.test(arg)) {\n  action = 'set'; time = arg;\n} else {\n  action = 'invalid';\n  reply_invalid = 'Formato invalido. Usa: /despertador HH:MM (ej 07:30) o /despertador off';\n}\n\nlet sql;\nif (action === 'set') {\n  sql = `UPDATE alarm_config SET alarm_time='${time}', enabled=true, updated_at=now() WHERE id=1 RETURNING alarm_time, enabled;`;\n} else if (action === 'off') {\n  sql = `UPDATE alarm_config SET enabled=false, updated_at=now() WHERE id=1 RETURNING alarm_time, enabled;`;\n} else {\n  sql = `SELECT alarm_time, enabled FROM alarm_config WHERE id=1;`;\n}\n\nreturn { json: { action, time, chatId, sql, reply_invalid } };"
      },

    {
      "parameters": {
        "jsCode": "const p = $('Parsear despertador').item.json;\nconst row = $input.item.json || {};\nlet text;\nif (p.action === 'invalid') {\n  text = p.reply_invalid;\n} else if (p.action === 'set') {\n  text = `⏰ Despertador programado a las ${row.alarm_time} hs, todos los dias.`;\n} else if (p.action === 'off') {\n  text = `Despertador anulado. No suena hasta que lo vuelvas a programar.`;\n} else {\n  if (row.enabled && row.alarm_time) {\n    text = `⏰ Despertador activo a las ${row.alarm_time} hs, todos los dias.\\nCambiar: /despertador HH:MM\\nAnular: /despertador off`;\n  } else {\n    text = `Despertador apagado.\\nProgramar: /despertador HH:MM`;\n  }\n}\nreturn { json: { chatId: p.chatId, text } };"
      },

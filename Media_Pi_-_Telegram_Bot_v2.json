    {
      "parameters": {
        "jsCode": "// Mapear callback_data o /comando a endpoint y método de la API\nconst input = $input.item.json;\n\nconst raw = input.callback_query?.data\n         ?? input.message?.text?.replace(/^\\//, '').split(' ')[0];\n\nconst commandMap = {\n  play:     { path: '/control/play',   method: 'POST', body: null },\n  pause:    { path: '/control/pause',  method: 'POST', body: null },\n  next:     { path: '/control/next',   method: 'POST', body: null },\n  prev:     { path: '/control/prev',   method: 'POST', body: null },\n  stop:     { path: '/control/stop',   method: 'POST', body: null },\n  status:   { path: '/status',         method: 'GET',  body: null },\n  vol_up:   { path: '/control/volume', method: 'POST', body: { delta: 10 } },\n  vol_down: { path: '/control/volume', method: 'POST', body: { delta: -10 } },\n};\n\nlet action = null;\nlet is_replay = false;\n\n// Botón del menú de /repetir: \"replay:<uuid>\"\nif (raw && raw.startsWith('replay:')) {\n  const id = raw.split(':')[1];\n  if (/^[0-9a-f-]{36}$/i.test(id)) {\n    action = { path: `/playlist/${id}/replay?sin_skips=true`, method: 'POST', body: null };\n    is_replay = true;\n  }\n} else {\n  action = commandMap[raw];\n}\n\nif (!action) {\n  return { json: { error: `Comando no reconocido: ${raw}`, command: raw } };\n}\n\nreturn {\n  json: {\n    command: raw,\n    is_replay,\n    path: action.path,\n    method: action.method,\n    body: action.body || {},\n    chat_id: input.message?.chat?.id ?? input.callback_query?.message?.chat?.id,\n    callback_query_id: input.callback_query?.id ?? null,\n  }\n};"
      },

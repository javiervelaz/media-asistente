    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\n\nif (!items.length) {\n  return [{ json: {\n    texto: 'Todavía no hay playlists en el historial.',\n    payload: null,\n  }}];\n}\n\nconst fmt = (d) => new Date(d).toLocaleString('es-AR', {\n  timeZone: 'America/Argentina/Cordoba',\n  day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit',\n});\n\nconst icono = { local: '💾', hybrid: '🔀', replay: '🔁', curator: '🤖' };\n\nconst inline_keyboard = items.map(p => ([{\n  text: `${icono[p.source] || '🎵'} ${p.title} · ${fmt(p.created_at)} · ${p.tracks}t`,\n  callback_data: `replay:${p.id}`,\n}]));\n\nreturn [{ json: {\n  texto: '🔁 ¿Cuál repetimos?',\n  payload: JSON.stringify({ inline_keyboard }),\n}}];"
      },
